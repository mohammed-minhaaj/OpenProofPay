# ==============================================================================
# OPENPROOFPAY — MASTER ENVIRONMENT VARIABLE TEMPLATE
# ==============================================================================
# Security Notice: Never commit actual secret values to version control.
# Copy this file to .env in each corresponding app directory.

# ------------------------------------------------------------------------------
# 1. API SERVER CONFIGURATION (/apps/api)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
CLIENT_ORIGIN=http://localhost:3000
EXTENSION_ID=chrome-extension://abcdefghijklmnopqrstuvwxyz123456

# ------------------------------------------------------------------------------
# 2. DATABASE (MongoDB)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/openproofpay

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECRETS
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_minimum_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_minimum_32_characters_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ------------------------------------------------------------------------------
# 4. GITHUB APP & WEBHOOK INTEGRATION
# ------------------------------------------------------------------------------
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_BASE64=LS0tLS1CRUdJTiBSU0EgUFJJVkFURSBLRVktLS0tLQp...
GITHUB_CLIENT_ID=Iv1.your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_signature_key

# ------------------------------------------------------------------------------
# 5. AI VERIFICATION ENGINE (LLM)
# ------------------------------------------------------------------------------
# Provider: GEMINI
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL_NAME=gemini-3.5-flash
AI_TEMPERATURE=0.2

# ------------------------------------------------------------------------------
# 6. ISOLATED TEST RUNNER (Docker / Container Sandbox)
# ------------------------------------------------------------------------------
DOCKER_RUNNER_ENABLED=true
DOCKER_IMAGE_RUNNER=node:20-alpine
DOCKER_MEMORY_LIMIT=512m
DOCKER_CPU_LIMIT=1.0
TEST_EXECUTION_TIMEOUT_MS=120000

# ------------------------------------------------------------------------------
# 7. PAYPAL SANDBOX INTEGRATION
# ------------------------------------------------------------------------------
PAYPAL_MODE=sandbox
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here
PAYPAL_PAYOUTS_ENABLED=false
PAYPAL_BN_CODE=OpenProofPay_ProofToPay

# ------------------------------------------------------------------------------
# 8. WEB DASHBOARD (/apps/web)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api/v1
VITE_GITHUB_CLIENT_ID=Iv1.your_github_client_id

# ------------------------------------------------------------------------------
# 9. CHROME EXTENSION (/apps/extension)
# ------------------------------------------------------------------------------
# NOTE: The extension NEVER receives backend secrets or PayPal client secrets!
VITE_API_URL=http://localhost:5000/api/v1
