# API Server Environment Variables
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
CLIENT_ORIGIN=http://localhost:3000
EXTENSION_ID=chrome-extension://abcdefghijklmnopqrstuvwxyz123456

# Database
MONGODB_URI=mongodb://localhost:27017/openproofpay

# Auth
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_minimum_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_minimum_32_characters_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# GitHub
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_BASE64=LS0tLS1CRUdJTiBSU0EgUFJJVkFURSBLRVktLS0tLQp...
GITHUB_CLIENT_ID=Iv1.your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_signature_key

# AI Verification
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL_NAME=gemini-3.5-flash
AI_TEMPERATURE=0.2

# Sandbox Test Runner
DOCKER_RUNNER_ENABLED=true
DOCKER_IMAGE_RUNNER=node:20-alpine
DOCKER_MEMORY_LIMIT=512m
DOCKER_CPU_LIMIT=1.0
TEST_EXECUTION_TIMEOUT_MS=120000

# PayPal Sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here
PAYPAL_BN_CODE=OpenProofPay_ProofToPay
