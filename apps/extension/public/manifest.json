{
  "manifest_version": 3,
  "name": "OpenProofPay — Proof-to-Pay for GitHub",
  "version": "1.0.0",
  "description": "AI-powered work verification and milestone-based PayPal payments for GitHub issues and pull requests.",
  "permissions": [
    "sidePanel",
    "storage",
    "notifications",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://localhost:5001/*",
    "http://127.0.0.1:5001/*",
    "https://api.openproofpay.com/*",
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OpenProofPay Quick Actions",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
